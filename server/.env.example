# ResumeCraft backend configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it contains secrets.

# ---- AWS S3 (resume storage) ----
# IAM user/role with least-privilege access to bucket "resumecraft_resume_collection".
# Required permissions: s3:PutObject, s3:GetObject, s3:DeleteObject on the bucket.
# Set these ONLY after you have created the IAM user in AWS and downloaded the keys.
# Example:
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1
AWS_S3_BUCKET=resumecraft_resume_collection

# ---- Application ----
NODE_ENV=development
PORT=3000
# Secret used to sign JWTs / session cookies. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
# Comma-separated list of allowed CORS origins (browser clients). Use "*" only locally.
CORS_ORIGINS=*

# ---- Storage mode ----
# "s3" = upload resumes to AWS S3 (needs valid AWS_* creds above)
# "local" = store resumes on disk under ./uploads (used automatically when AWS creds are missing)
STORAGE_MODE=s3